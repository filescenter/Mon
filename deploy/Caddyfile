# Caddy gets and renews the HTTPS certificate for the domain by itself.
{$DOMAIN} {
	encode zstd gzip

	# Visitors land on the app; the back office stays at /odoo.
	redir / /app 302

	# The database manager is never needed from the internet.
	@dbmanager path /web/database/*
	respond @dbmanager 404

	# Live updates of the back office use a separate Odoo port.
	@websocket path /websocket*
	reverse_proxy @websocket odoo:8072

	reverse_proxy odoo:8069
}
