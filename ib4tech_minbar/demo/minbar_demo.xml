<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sample pages: fictional names and numbers, only to show how the app looks. -->
        <record id="demo_husseiniya_1" model="ib4tech.minbar.entity">
            <field name="name">حسينية الزهراء (ع) - تجريبي</field>
            <field name="entity_type">husseiniya</field>
            <field name="tagline">مجالس أسبوعية كل ليلة جمعة</field>
            <field name="description">حسينية تجريبية لعرض شكل الصفحة في التطبيق.
تقام فيها المجالس الحسينية في المناسبات وليالي الجمعة، ودروس للناشئة بعد صلاة المغرب.</field>
            <field name="city_id" ref="city_sadr_city"/>
            <field name="address">مدينة الصدر - قطاع 33</field>
            <field name="latitude">33.389</field>
            <field name="longitude">44.458</field>
            <field name="phone">07800000001</field>
            <field name="whatsapp">07800000001</field>
            <field name="telegram">example_husseiniya</field>
            <field name="founded_year">1998</field>
            <field name="image_1920" type="base64" file="ib4tech_minbar/static/demo/avatar-husseiniya.jpg"/>
            <field name="cover_image" type="base64" file="ib4tech_minbar/static/demo/cover-green.jpg"/>
            <field name="is_verified" eval="True"/>
            <field name="state">published</field>
        </record>
        <record id="demo_husseiniya_2" model="ib4tech.minbar.entity">
            <field name="name">حسينية أهل البيت (ع) - تجريبي</field>
            <field name="entity_type">husseiniya</field>
            <field name="city_id" ref="city_shula"/>
            <field name="address">الشعلة - الشارع العام</field>
            <field name="phone">07800000002</field>
            <field name="state">published</field>
        </record>
        <record id="demo_mawkib_1" model="ib4tech.minbar.entity">
            <field name="name">موكب أنصار الحسين (ع) - تجريبي</field>
            <field name="entity_type">mawkib</field>
            <field name="tagline">خدمة زوار الأربعين على طريق يا حسين</field>
            <field name="description">موكب تجريبي من أهالي مدينة الصدر يقدم الطعام والمبيت والطبابة للزائرين في موسم الأربعين.</field>
            <field name="city_id" ref="city_sadr_city"/>
            <field name="address">مدينة الصدر - قطاع 12</field>
            <field name="phone">07800000003</field>
            <field name="whatsapp">07800000003</field>
            <field name="telegram">example_mawkib</field>
            <field name="instagram">example_mawkib</field>
            <field name="service_ids" eval="[(6, 0, [ref('service_food'), ref('service_drinks'), ref('service_lodging'), ref('service_medical')])]"/>
            <field name="image_1920" type="base64" file="ib4tech_minbar/static/demo/avatar-mawkib.jpg"/>
            <field name="cover_image" type="base64" file="ib4tech_minbar/static/demo/cover-night.jpg"/>
            <field name="is_verified" eval="True"/>
            <field name="state">published</field>
        </record>
        <record id="demo_mawkib_2" model="ib4tech.minbar.entity">
            <field name="name">موكب شباب القاسم (ع) - تجريبي</field>
            <field name="entity_type">mawkib</field>
            <field name="city_id" ref="city_baladiyat"/>
            <field name="service_ids" eval="[(6, 0, [ref('service_food'), ref('service_rest')])]"/>
            <field name="state">published</field>
        </record>
        <record id="demo_radood_1" model="ib4tech.minbar.entity">
            <field name="name">الرادود التجريبي الأول</field>
            <field name="entity_type">radood</field>
            <field name="tagline">رادود حسيني</field>
            <field name="city_id" ref="city_sadr_city"/>
            <field name="instagram">example_radood</field>
            <field name="image_1920" type="base64" file="ib4tech_minbar/static/demo/avatar-radood.jpg"/>
            <field name="is_verified" eval="True"/>
            <field name="state">published</field>
        </record>
        <record id="demo_radood_2" model="ib4tech.minbar.entity">
            <field name="name">الرادود التجريبي الثاني</field>
            <field name="entity_type">radood</field>
            <field name="city_id" ref="city_najaf"/>
