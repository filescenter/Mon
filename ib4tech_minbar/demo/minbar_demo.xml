            <field name="tagline">خطيب المنبر الحسيني</field>
            <field name="city_id" ref="city_kadhimiya"/>
            <field name="state">published</field>
        </record>
        <record id="demo_pending_1" model="ib4tech.minbar.entity">
            <field name="name">موكب بانتظار المراجعة - تجريبي</field>
            <field name="entity_type">mawkib</field>
            <field name="city_id" ref="city_shaab"/>
            <field name="contact_name">مسؤول تجريبي</field>
            <field name="contact_phone">07800000009</field>
            <field name="state">pending</field>
        </record>

        <!-- Sample majalis around the installation date (times stored in UTC). -->
        <record id="demo_majlis_1" model="ib4tech.minbar.majlis">
            <field name="name">المجلس الأسبوعي</field>
            <field name="entity_id" ref="demo_husseiniya_1"/>
            <field name="participant_ids" eval="[(6, 0, [ref('demo_radood_1'), ref('demo_khatib_1')])]"/>
            <field name="poster" type="base64" file="ib4tech_minbar/static/demo/poster.jpg"/>
            <field name="date_start" eval="(DateTime.today() + relativedelta(days=0)).strftime('%Y-%m-%d 16:30:00')"/>
            <field name="date_end" eval="(DateTime.today() + relativedelta(days=0)).strftime('%Y-%m-%d 18:30:00')"/>
            <field name="state">published</field>
        </record>
        <record id="demo_majlis_2" model="ib4tech.minbar.majlis">
            <field name="name">مجلس عزاء نسائي</field>
            <field name="entity_id" ref="demo_husseiniya_1"/>
            <field name="audience">women</field>
            <field name="guest_names">الملاية أم تجريبي</field>
            <field name="date_start" eval="(DateTime.today() + relativedelta(days=1)).strftime('%Y-%m-%d 13:00:00')"/>
            <field name="state">published</field>
        </record>
        <record id="demo_majlis_3" model="ib4tech.minbar.majlis">
            <field name="name">أمسية حسينية</field>
            <field name="entity_id" ref="demo_mawkib_1"/>
            <field name="participant_ids" eval="[(6, 0, [ref('demo_radood_2')])]"/>
            <field name="location">ساحة الموكب - قطاع 12</field>
            <field name="live_url">https://example.com/live</field>
            <field name="date_start" eval="(DateTime.today() + relativedelta(days=1)).strftime('%Y-%m-%d 17:00:00')"/>
            <field name="date_end" eval="(DateTime.today() + relativedelta(days=1)).strftime('%Y-%m-%d 19:00:00')"/>
            <field name="state">published</field>
        </record>
        <record id="demo_majlis_4" model="ib4tech.minbar.majlis">
            <field name="name">مجلس الشعلة الأسبوعي</field>
            <field name="entity_id" ref="demo_husseiniya_2"/>
            <field name="participant_ids" eval="[(6, 0, [ref('demo_radood_1')])]"/>
            <field name="date_start" eval="(DateTime.today() + relativedelta(days=3)).strftime('%Y-%m-%d 16:00:00')"/>
            <field name="state">published</field>
        </record>
        <record id="demo_majlis_5" model="ib4tech.minbar.majlis">
            <field name="name">مجلس بانتظار المراجعة</field>
            <field name="entity_id" ref="demo_mawkib_2"/>
            <field name="date_start" eval="(DateTime.today() + relativedelta(days=5)).strftime('%Y-%m-%d 16:00:00')"/>
            <field name="state">pending</field>
        </record>
    </data>
</odoo>
