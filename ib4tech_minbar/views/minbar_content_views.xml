<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_minbar_content_search" model="ir.ui.view">
        <field name="name">ib4tech.minbar.content.search</field>
        <field name="model">ib4tech.minbar.content</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_id"/>
                <filter name="filter_featured" string="Featured" domain="[('is_featured', '=', True)]"/>
                <filter name="filter_unpublished" string="Not Published" domain="[('is_published', '=', False)]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_category" string="Section" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_minbar_content_list" model="ir.ui.view">
        <field name="name">ib4tech.minbar.content.list</field>
        <field name="model">ib4tech.minbar.content</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="weekday" optional="show"/>
                <field name="occasion_id" optional="hide"/>
                <field name="is_featured" widget="boolean_toggle"/>
                <field name="is_published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_minbar_content_form" model="ir.ui.view">
        <field name="name">ib4tech.minbar.content.form</field>
        <field name="model">ib4tech.minbar.content</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Dua Kumayl"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="source"/>
                            <field name="audio_url" widget="url"/>
                        </group>
                        <group>
                            <field name="weekday"/>
                            <field name="occasion_id"/>
                            <field name="is_featured"/>
                            <field name="is_published"/>
                        </group>
                    </group>
                    <group string="Introduction">
                        <field name="intro" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Text">
                        <field name="body" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_minbar_content" model="ir.actions.act_window">
        <field name="name">Library Texts</field>
        <field name="res_model">ib4tech.minbar.content</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_category': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the first dua or ziyarah</p>
        </field>
    </record>

    <record id="view_minbar_content_category_list" model="ir.ui.view">
        <field name="name">ib4tech.minbar.content.category.list</field>
        <field name="model">ib4tech.minbar.content.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="icon"/>
                <field name="content_count" string="Texts"/>
            </list>
        </field>
    </record>

    <record id="action_minbar_content_category" model="ir.actions.act_window">
        <field name="name">Library Sections</field>
        <field name="res_model">ib4tech.minbar.content.category</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
