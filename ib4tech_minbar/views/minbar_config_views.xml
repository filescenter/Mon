<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_minbar_city_list" model="ir.ui.view">
        <field name="name">ib4tech.minbar.city.list</field>
        <field name="model">ib4tech.minbar.city</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="governorate"/>
                <field name="latitude"/>
                <field name="longitude"/>
                <field name="tz" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_minbar_city" model="ir.actions.act_window">
        <field name="name">Cities</field>
        <field name="res_model">ib4tech.minbar.city</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_minbar_service_list" model="ir.ui.view">
        <field name="name">ib4tech.minbar.service.list</field>
        <field name="model">ib4tech.minbar.service</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_minbar_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">ib4tech.minbar.service</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_minbar_occasion_list" model="ir.ui.view">
        <field name="name">ib4tech.minbar.occasion.list</field>
        <field name="model">ib4tech.minbar.occasion</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="hijri_month"/>
                <field name="hijri_day"/>
                <field name="name"/>
                <field name="occasion_type"/>
            </list>
        </field>
    </record>

    <record id="view_minbar_occasion_search" model="ir.ui.view">
        <field name="name">ib4tech.minbar.occasion.search</field>
        <field name="model">ib4tech.minbar.occasion</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <group>
                    <filter name="group_month" string="Hijri Month" context="{'group_by': 'hijri_month'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'occasion_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_minbar_occasion" model="ir.actions.act_window">
        <field name="name">Hijri Occasions</field>
        <field name="res_model">ib4tech.minbar.occasion</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
