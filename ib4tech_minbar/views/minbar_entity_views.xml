<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_minbar_entity_search" model="ir.ui.view">
        <field name="name">ib4tech.minbar.entity.search</field>
        <field name="model">ib4tech.minbar.entity</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="city_id"/>
                <field name="owner_user_id"/>
                <filter name="filter_pending" string="Waiting Review" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_published" string="Published" domain="[('state', '=', 'published')]"/>
                <filter name="filter_verified" string="Verified" domain="[('is_verified', '=', True)]"/>
                <filter name="filter_no_owner" string="Without Owner Account" domain="[('owner_user_id', '=', False)]"/>
                <separator/>
                <filter name="filter_husseiniya" string="Husseiniyas" domain="[('entity_type', '=', 'husseiniya')]"/>
                <filter name="filter_mawkib" string="Mawakib" domain="[('entity_type', '=', 'mawkib')]"/>
                <filter name="filter_radood" string="Radoods" domain="[('entity_type', '=', 'radood')]"/>
                <filter name="filter_khatib" string="Khatibs" domain="[('entity_type', '=', 'khatib')]"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'entity_type'}"/>
                    <filter name="group_city" string="City" context="{'group_by': 'city_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_minbar_entity_list" model="ir.ui.view">
        <field name="name">ib4tech.minbar.entity.list</field>
        <field name="model">ib4tech.minbar.entity</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="entity_type"/>
                <field name="city_id"/>
                <field name="phone" optional="show"/>
                <field name="owner_user_id" optional="show"/>
                <field name="is_verified" widget="boolean_toggle" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'pending'"
                       decoration-success="state == 'published'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_minbar_entity_kanban" model="ir.ui.view">
        <field name="name">ib4tech.minbar.entity.kanban</field>
        <field name="model">ib4tech.minbar.entity</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside>
                            <field name="image_128" widget="image" class="o_image_64_cover" alt="Picture"/>
                        </aside>
                        <main class="ms-3">
                            <field name="name" class="fw-bold fs-5"/>
                            <div class="text-muted">
                                <field name="entity_type"/> · <field name="city_id"/>
                            </div>
                            <field name="state" widget="badge"
                                   decoration-info="state == 'pending'"
                                   decoration-success="state == 'published'"
                                   decoration-danger="state == 'rejected'"/>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_minbar_entity_form" model="ir.ui.view">
        <field name="name">ib4tech.minbar.entity.form</field>
        <field name="model">ib4tech.minbar.entity</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Send for Review"
                            invisible="state not in ('draft', 'rejected')"/>
                    <button name="action_publish" type="object" string="Approve &amp; Publish"
                            class="btn-primary" invisible="state not in ('draft', 'pending', 'rejected')"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'pending'"/>
                    <button name="action_reset_draft" type="object" string="Unpublish"
                            invisible="state != 'published'"
                            confirm="The page and its majalis will disappear from the app. Continue?"/>
                    <button name="action_grant_portal_access" type="object" string="Create Owner Account"
                            groups="ib4tech_minbar.group_minbar_manager"
                            invisible="owner_user_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,published"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_majalis" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="majlis_count" widget="statinfo" string="Majalis"/>
                        </button>
                        <button name="action_open_app_page" type="object" class="oe_stat_button" icon="fa-mobile"
                                invisible="state != 'published'">
                            <div class="o_stat_info"><span class="o_stat_text">Open in App</span></div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Husseiniya of ..."/></h1>
                        <field name="tagline" placeholder="Short line shown under the name"/>
                    </div>
                    <group>
                        <group string="Page">
                            <field name="entity_type"/>
                            <field name="city_id"/>
                            <field name="address"/>
                            <field name="founded_year" options="{'format': false}"/>
                            <field name="service_ids" widget="many2many_tags"
                                   invisible="entity_type not in ('mawkib', 'husseiniya')"/>
                            <field name="is_verified"/>
                        </group>
                        <group string="Contact Channels">
                            <field name="phone" widget="phone"/>
                            <field name="whatsapp"/>
                            <field name="telegram"/>
                            <field name="instagram"/>
                            <field name="facebook"/>
                            <field name="youtube"/>
                            <field name="website_url" widget="url"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="About" name="about">
                            <field name="description" placeholder="History, activities, weekly programme..."/>
                        </page>
                        <page string="Cover &amp; Map" name="media">
                            <group>
                                <group>
                                    <field name="cover_image" widget="image" options="{'size': [400, 225]}"/>
                                </group>
                                <group>
                                    <field name="latitude"/>
                                    <field name="longitude"/>
                                </group>
                            </group>
                        </page>
                        <page string="Owner" name="owner">
                            <group>
                                <group string="Account">
                                    <field name="owner_user_id"/>
                                </group>
                                <group string="Contact of the Applicant">
                                    <field name="contact_name"/>
                                    <field name="contact_phone" widget="phone"/>
                                    <field name="contact_email" widget="email"/>
                                </group>
                            </group>
                            <group string="Rejection Reason" invisible="state not in ('pending', 'rejected')">
                                <field name="reject_reason" nolabel="1" colspan="2"
                                       placeholder="Shown to the owner when the page is rejected"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_minbar_entity" model="ir.actions.act_window">
        <field name="name">Directory</field>
        <field name="res_model">ib4tech.minbar.entity</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the first husseiniya, mawkib or radood</p>
            <p>Each page is shown in the app once it is published.</p>
        </field>
    </record>

    <record id="action_minbar_entity_review" model="ir.actions.act_window">
        <field name="name">Pages to Review</field>
        <field name="res_model">ib4tech.minbar.entity</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'pending')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing is waiting for a review</p>
        </field>
    </record>
</odoo>
