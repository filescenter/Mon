<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ib4tech.minbar</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Al-Siddiqa" string="Al-Siddiqa" name="ib4tech_minbar"
                     groups="ib4tech_minbar.group_minbar_manager">
                    <block title="Mobile App" name="minbar_app">
                        <setting string="App Name" help="Shown in the header and on the phone home screen.">
                            <field name="minbar_app_name" placeholder="الصدّيقة"/>
                        </setting>
                        <setting string="Timezone" help="Majalis times are shown in this timezone.">
                            <field name="minbar_tz"/>
                        </setting>
                        <setting string="Default City" help="Used for prayer times until the visitor picks a city.">
                            <field name="minbar_default_city_id"/>
                        </setting>
                        <setting string="Hijri Date Adjustment"
                                 help="Shift the computed hijri date to follow the local moon sighting.">
                            <field name="minbar_hijri_offset"/> days
                        </setting>
                        <setting help="The app turns black during Muharram, Safar and on martyrdom anniversaries.">
                            <field name="minbar_mourning_theme"/>
                        </setting>
                    </block>
                    <block title="Owners" name="minbar_owners">
                        <setting help="Majalis added by the owner of a verified page skip the review queue.">
                            <field name="minbar_auto_publish_verified"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_minbar_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'ib4tech_minbar', 'bin_size': False}</field>
    </record>
</odoo>
